# Copy to .env for local use only. Never commit actual credentials.
# Live mode requires both official service accounts and appropriate API access.
LLM_API_KEY=
GPTZERO_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional alternative Unicode TrueType font; bundled NanumGothic is the default.
# PDF_FONT_PATH=/absolute/path/to/font.ttf

# Hosting configuration. Local defaults keep per-run JSON history on disk.
# Set hosted=1 and save_history=0 on public hosting services.
TEXTLAB_HOSTED=0
TEXTLAB_SAVE_HISTORY=1
TEXTLAB_MAX_CONCURRENT_RUNS=2
# Optional private-site password; required for live APIs when hosted=1.
# Set securely on the hosting service, never commit its actual value.
APP_ACCESS_PASSWORD=
